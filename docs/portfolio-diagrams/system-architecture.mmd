  classDef decision fill:#FFFBEB,stroke:#B45309,color:#0F172A,stroke-width:1px;
  classDef ops fill:#F8FAFC,stroke:#94A3B8,color:#0F172A,stroke-width:1px;
  class UI,REST,PROXY,OPENAI interface;
  class APP,EVAL,BEAT,WORKER service;
  class PG,REDIS store;
  class ENGINE decision;
  class CASES,SIGNALS ops;
