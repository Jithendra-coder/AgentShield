# Copy to .env and replace each value with a unique random value before starting.
POSTGRES_PASSWORD=replace_with_48_character_alphanumeric_secret
REDIS_PASSWORD=replace_with_48_character_alphanumeric_secret
AGENTSHIELD_BOOTSTRAP_API_KEY=ash_replace_with_at_least_32_random_characters
AGENTSHIELD_PLATFORM_API_KEY=ash_replace_with_a_different_32_random_characters
AGENTSHIELD_ALLOWED_HOSTS=localhost,127.0.0.1,agentshield.example.com
OPENAI_API_KEY=
AGENTSHIELD_OPENAI_MODEL=gpt-6-astra
